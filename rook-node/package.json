{
  "name": "@rook/node",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Rook desktop — full chat, Bots, files, and a local Rook Node in one Tauri window. The sidecar (supervised Chromium + cloud uplink) lives in src/.",
  "main": "dist/index.js",
  "bin": {
    "rook-node": "dist/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "pkg": {
    "assets": [
      "node_modules/**/playwright/**",
      "node_modules/**/playwright-core/**",
      "node_modules/**/ws/**"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:js": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=build/index.cjs --external:playwright --external:ws --log-level=error",
    "prebundle:exe": "node scripts/patch-inspector.mjs",
    "bundle:exe": "pnpm run bundle:js && pnpm dlx @yao-pkg/pkg build/index.cjs --config package.json -t node24-win-x64,node24-macos-arm64,node24-macos-x64,node24-linux-x64 --output build/rook-node",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "app:dev": "vite",
    "app:build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "app:typecheck": "tsc -p tsconfig.app.json --noEmit",
    "app:preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm app:build && tauri build",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@clerk/clerk-react": "^5.31.0",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "playwright": "1.62.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "ws": "8.21.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^22.19.3",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  }
}
