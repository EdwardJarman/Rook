{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rook Node",
  "version": "0.1.17",
  "identifier": "com.rook.node",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rook Node",
        "width": 560,
        "height": 520,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "appimage", "dmg"],
    "category": "Utility",
    "shortDescription": "Rook Node — the forever-free computer runner for your Bots.",
    "longDescription": "Rook Node runs a supervised, version-pinned Chromium on the user's own computer. It provides a dedicated Rook profile, per-Bot tab groups, a control gateway, durable local state, a shared workspace, and live-screen input control. The app remains the control surface; the user's own machine becomes the Bot computer.",
    "externalBin": ["binaries/rook-node-sidecar"],
    "resources": ["resources/chromium"],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
