# Keep scripts/vercel-build.mjs so the buildCommand in vercel.json can run it.
# Also keep scripts/load-env.js because app.config.ts requires it.
scripts/*
!scripts/vercel-build.mjs
!scripts/load-env.js

# Don't ignore the api function (it's a serverless function, not source).
!api/
# Keep dist-server/ so the api function can import the pre-bundled server.
!dist-server/
